# Google AI Studio で発行した API キー（https://aistudio.google.com/）
GEMINI_API_KEY=

# 問い合わせフォームの URL
NEXT_PUBLIC_CONTACT_FORM_URL=https://www.kenpalinc.com/contact

# Upstash Redis（レートリミット用）
# https://console.upstash.com/ で無料 Redis を作成して取得
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS 許可オリジン（カンマ区切り）
# 本番では Vercel の URL と kenpalinc.com を指定する
# 例: https://your-chatbot.vercel.app,https://www.kenpalinc.com
ALLOWED_ORIGINS=
